{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Create your blog content"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "excerpt": {
      "type": "text",
      "maxLength": 80
    },
    "content": {
      "type": "blocks"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "press-release",
        "news-event",
        "featured-article"
      ]
    },
    "articleType": {
      "type": "enumeration",
      "enum": [
        "internal",
        "external"
      ]
    },
    "externalUrl": {
      "type": "string"
    },
    "externalSource": {
      "type": "string"
    },
    "isFeatured": {
      "type": "boolean"
    },
    "isHighlighted": {
      "type": "boolean"
    },
    "tags": {
      "type": "json"
    }
  }
}
