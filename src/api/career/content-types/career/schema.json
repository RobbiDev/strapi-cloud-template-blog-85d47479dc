{
  "kind": "collectionType",
  "collectionName": "careers",
  "info": {
    "singularName": "career",
    "pluralName": "careers",
    "displayName": "Career Postings"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "text"
    },
    "slug": {
      "type": "uid"
    },
    "description": {
      "type": "text"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "technology-it ",
        "maintenance",
        "general-labor",
        "accounting-finance",
        "operations",
        "sales-marketing",
        "engineering",
        "quality-assurance`"
      ]
    },
    "experienceLevel": {
      "type": "enumeration",
      "enum": [
        "entry",
        "intermediate",
        "experienced",
        "senior",
        "management"
      ]
    },
    "jobType": {
      "type": "enumeration",
      "enum": [
        "full-time",
        "part-time",
        "contract"
      ]
    },
    "locationType": {
      "type": "enumeration",
      "enum": [
        "on-site",
        "hybrid",
        "remote"
      ]
    },
    "location": {
      "type": "enumeration",
      "enum": [
        "Montreal, QC",
        "Thomasville, NC",
        "Victoriaville, QC"
      ]
    },
    "postedAt": {
      "type": "date"
    },
    "closingDate": {
      "type": "datetime"
    },
    "applicationType": {
      "type": "enumeration",
      "enum": [
        "internal",
        "external"
      ]
    },
    "externalUrl": {
      "type": "text"
    },
    "salary": {
      "type": "text"
    },
    "requirements": {
      "type": "blocks"
    },
    "responsibilities": {
      "type": "blocks"
    },
    "isActive": {
      "type": "boolean"
    },
    "isFeatured": {
      "type": "boolean"
    }
  }
}
